{
  "_comment": "Copy relevant blocks into data/mcp.json (gitignored). Secrets can be ${ENV_VARS}, expanded from your environment at startup — keep real tokens out of this file.",
  "servers": [
    {
      "name": "whatsapp",
      "command": "npx",
      "args": ["-y", "mantrin-whatsapp@latest"],
      "env": {
        "WHATSAPP_MCP_DATA_DIR": "${HOME}/.local/share/mantrin/whatsapp"
      }
    },
    {
      "name": "slack",
      "command": "npx",
      "args": ["-y", "slack-mcp-server@latest"],
      "env": {
        "SLACK_MCP_XOXP_TOKEN": "${SLACK_XOXP_TOKEN}",
        "SLACK_MCP_ADD_MESSAGE_TOOL": "true"
      }
    },
    {
      "name": "google-calendar",
      "command": "npx",
      "args": ["-y", "@cocal/google-calendar-mcp"],
      "env": {
        "GOOGLE_OAUTH_CREDENTIALS": "${GOOGLE_OAUTH_CREDENTIALS}"
      }
    },
    {
      "name": "gmail",
      "command": "npx",
      "args": ["-y", "@gongrzhe/server-gmail-autoauth-mcp"]
    },
    {
      "name": "notion",
      "command": "npx",
      "args": ["-y", "@notionhq/notion-mcp-server"],
      "env": {
        "NOTION_TOKEN": "${NOTION_TOKEN}"
      }
    },
    {
      "name": "github",
      "command": "docker",
      "args": [
        "run", "-i", "--rm",
        "-e", "GITHUB_PERSONAL_ACCESS_TOKEN",
        "-e", "GITHUB_TOOLSETS",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PAT}",
        "GITHUB_TOOLSETS": "context,repos,issues,pull_requests,notifications"
      }
    },
    {
      "name": "home-assistant",
      "command": "uvx",
      "args": ["mcp-proxy", "http://homeassistant.local:8123/mcp_server/sse"],
      "env": {
        "API_ACCESS_TOKEN": "${HASS_TOKEN}"
      }
    },
    {
      "name": "spotify",
      "command": "uvx",
      "args": ["--from", "git+https://github.com/varunneal/spotify-mcp", "spotify-mcp"],
      "env": {
        "SPOTIFY_CLIENT_ID": "${SPOTIFY_CLIENT_ID}",
        "SPOTIFY_CLIENT_SECRET": "${SPOTIFY_CLIENT_SECRET}",
        "SPOTIFY_REDIRECT_URI": "http://127.0.0.1:8080/callback"
      }
    },
    {
      "name": "weather",
      "command": "uvx",
      "args": ["--with", "mcp<2", "--from", "open-meteo-mcp", "open_meteo_mcp"]
    },
    {
      "name": "google-maps",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-google-maps"],
      "env": {
        "GOOGLE_MAPS_API_KEY": "${GOOGLE_MAPS_API_KEY}"
      }
    }
  ]
}
